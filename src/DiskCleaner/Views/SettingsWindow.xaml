<Window x:Class="DiskCleaner.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 设置" Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="32,32">
        <TextBlock Text="AI 文件分析" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
        <TextBlock Text="选择 AI 提供商，填写 API Key，即可批量分析文件" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24" />

        <!-- 提供商选择 -->
        <TextBlock Text="AI 提供商" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <ComboBox x:Name="CmbProvider" SelectionChanged="CmbProvider_Changed"
                  Style="{StaticResource ModernComboBox}" FontSize="13" Margin="0,0,0,16">
            <ComboBoxItem Tag="openai">OpenAI · ChatGPT</ComboBoxItem>
            <ComboBoxItem Tag="deepseek">DeepSeek · 深度求索</ComboBoxItem>
            <ComboBoxItem Tag="zhipu">智谱 · GLM</ComboBoxItem>
            <ComboBoxItem Tag="qwen">阿里 · 通义千问</ComboBoxItem>
            <ComboBoxItem Tag="moonshot">月之暗面 · Kimi</ComboBoxItem>
            <ComboBoxItem Tag="ernie">百度 · 文心一言</ComboBoxItem>
            <ComboBoxItem Tag="yi">零一万物 · Yi</ComboBoxItem>
            <ComboBoxItem Tag="custom">自定义 …</ComboBoxItem>
        </ComboBox>

        <!-- Endpoint (仅自定义时显示) -->
        <TextBlock x:Name="LblEndpoint" Text="API 地址" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" Visibility="Collapsed" />
        <TextBox x:Name="TxtEndpoint" Style="{StaticResource ModernTextBox}" FontSize="13"
                 Margin="0,0,0,16" Visibility="Collapsed" />

        <!-- API Key -->
        <TextBlock Text="API Key" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <PasswordBox x:Name="TxtApiKey"
                     Background="{StaticResource InputBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     Padding="12,8" CaretBrush="White"
                     PasswordChar="●" FontSize="13" Margin="0,0,0,16" />

        <!-- 模型 -->
        <TextBlock Text="模型" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <ComboBox x:Name="CmbModel" IsEditable="True"
                      Style="{StaticResource ModernComboBox}" FontSize="13"
                      Width="280" Margin="0,0,8,0" />
            <Button x:Name="BtnTest" Content="测试" Style="{StaticResource SecondaryButton}" 
                    Click="BtnTest_Click" Width="70" FontSize="12" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click" 
                    Width="100" FontSize="13" Margin="0,0,8,0" />
            <Button Content="取消" Style="{StaticResource GhostButton}" Click="BtnCancel_Click" 
                    Width="80" FontSize="13" />
        </StackPanel>

        <TextBlock x:Name="TxtStatus" Foreground="{StaticResource TextSecondaryBrush}" 
                   FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
