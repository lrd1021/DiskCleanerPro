<UserControl x:Class="DiskCleaner.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel>
            <TextBlock Text="保险箱 / 恢复" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
            <TextBlock Text="临时文件/浏览器缓存清理时，默认先移入此保险箱（不触发桌面刷新），可随时恢复。超过30天自动清理。"
                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24" TextWrapping="Wrap" />

            <!-- 操作栏 -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                    <Button Content="恢复选中/全部" Command="{Binding RestoreAllCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0" />
                    <Button Content="清理超过30天" Command="{Binding PurgeOldCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0" />
                    <Button Content="清空保险箱" Command="{Binding PurgeAllCommand}" Style="{StaticResource DangerButton}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </DockPanel>

            <!-- 统计卡片 -->
            <UniformGrid Columns="3" Margin="0,0,0,20">
                <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="保险箱文件数" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="占用空间" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding TotalSizeDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="说明" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="可恢复 · 不黑屏" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 保险箱列表（虚拟化，避免大量文件时卡顿） -->
            <ListBox ItemsSource="{Binding Items}"
                     MaxHeight="520"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                            <DockPanel>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="恢复" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Click="OpenLocation_Click" Cursor="Hand"
                                        Width="28" Height="24" Margin="0,0,12,0" ToolTip="在资源管理器中打开该文件当前位置">
                                    <TextBlock Text="📂" FontSize="13" />
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="Background" Value="#22FFFFFF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <StackPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding OriginalPath}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                        <Run Text="{Binding SizeDisplay, Mode=OneWay}" /><Run Text=" · 移入 " /><Run Text="{Binding TimeDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding SizeDisplay}" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="提示：恢复会把文件放回原始路径（已存在则加 .restored 后缀）；清空后不可恢复。"
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
