<UserControl x:Class="DiskCleaner.Views.DiskAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Padding="32,28,32,16">
            <StackPanel>
                <TextBlock Text="磁盘空间分析" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                <TextBlock Text="可视化分析C盘各目录空间占用，快速定位大文件夹" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />

                <DockPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding AnalyzeButtonText}" Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                        <Button Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="16,8" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <TextBlock FontSize="14">
                            <Run Text="C盘根目录总占用：" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text="{Binding TotalSizeDisplay, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="16" />
                        </TextBlock>
                    </Border>
                </DockPanel>

                <StackPanel Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,12,0,0">
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 文件夹列表 -->
        <TreeView ItemsSource="{Binding RootFolders}" Margin="32,0,32,28" Background="Transparent"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="Padding" Value="0,4" />
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <DockPanel ToolTip="{Binding FullPath}">
                        <Button Click="OpenLocation_Click" Tag="{Binding}"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="在资源管理器中打开此文件夹"
                                Margin="0,0,6,0" Padding="0"
                                VerticalAlignment="Center" Cursor="Hand">
                            <TextBlock Text="{Binding TypeIcon}" FontSize="14" VerticalAlignment="Center" Foreground="White" />
                        </Button>
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Run Text="{Binding SizeDisplay, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                            <Run Text="  " />
                            <Run Text="{Binding PercentageDisplay, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        </TextBlock>
                    </DockPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
