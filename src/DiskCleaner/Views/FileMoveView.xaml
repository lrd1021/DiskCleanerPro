<UserControl x:Class="DiskCleaner.Views.FileMoveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="32,28,32,16">
            <StackPanel>
                <TextBlock Text="文件搬家" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                <TextBlock Text="将C盘大文件迁移到其他盘，可选创建符号链接保持原路径可用" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />

                <DockPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🔍 扫描大文件" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                        <Button Content="📦 搬移选中文件" Command="{Binding MoveCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="扫描目录：" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding ScanPath}" Style="{StaticResource ModernTextBox}" Width="200" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="浏览" Command="{Binding BrowseCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,16,0" />
                        <TextBlock Text="最小(GB):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding MinFileSizeGB}" Style="{StaticResource ModernTextBox}" Width="50" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Text="目标盘：" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding TargetDrive}" Style="{StaticResource ModernComboBox}" Width="70" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox Content="创建符号链接" IsChecked="{Binding CreateSymlink}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,12,0,0">
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="13" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="32,0,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 大文件列表 -->
            <ListView Grid.Row="0" ItemsSource="{Binding LargeFiles}" Background="Transparent" BorderThickness="0" Foreground="White" Margin="0,0,0,12">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="文件名" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}" Foreground="White" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="大小" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeDisplay}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="路径" Width="400">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Directory}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="修改时间" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastModifiedDisplay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 搬移任务进度 -->
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Visibility="{Binding IsMoving, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <StackPanel>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,8" />
                    <ItemsControl ItemsSource="{Binding Tasks}" MaxHeight="120">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12" />
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
