<UserControl x:Class="DiskCleaner.Views.FileMoveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:DiskCleaner.Helpers"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <helpers:SortIndicatorConverter x:Key="SortIndicator" />
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="32,28,32,16">
            <StackPanel>
                <TextBlock Text="文件搬家" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                <TextBlock Text="把默认存 C 盘的应用数据目录整体搬到其它盘，原位建 junction，应用无感知照常使用" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />

                <DockPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="扫描目录" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                        <Button Content="搬移选中目录" Command="{Binding MoveCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="扫描目录：" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding ScanPath}" Style="{StaticResource ModernTextBox}" Width="200" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="浏览" Command="{Binding BrowseCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,16,0" />
                        <TextBlock Text="最小(MB):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding MinDirSizeMB}" Style="{StaticResource ModernTextBox}" Width="60" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Text="目标盘：" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding AvailableDrives}" SelectedItem="{Binding TargetDrive}" Style="{StaticResource ModernComboBox}" Width="70" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox Content="创建 junction（保持应用可用）" IsChecked="{Binding CreateJunction}" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,12,0,0">
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="13" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="32,0,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 目录列表 -->
            <ListView Grid.Row="0" ItemsSource="{Binding Directories}" Background="Transparent" BorderThickness="0" Foreground="White" Margin="0,0,0,12">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}" Padding="0,4">
                                        <GridViewRowPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <EventSetter Event="Click" Handler="OnHeaderClick" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="0,0,17,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="4,0,2,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                                <Path x:Name="UpArrow" Data="M0,4 L4,0 L8,4 Z" Width="8" Height="4"
                                                      Fill="{StaticResource TextMutedBrush}" Margin="0,0,0,1">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource SortIndicator}">
                                                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Content" />
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="DataContext.CurrentSortColumnHeader" />
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="DataContext.CurrentSortDirection" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Fill" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <Path x:Name="DownArrow" Data="M0,0 L4,4 L8,0 Z" Width="8" Height="4"
                                                      Fill="{StaticResource TextMutedBrush}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource SortIndicator}">
                                                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Content" />
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="DataContext.CurrentSortColumnHeader" />
                                                                            <Binding RelativeSource="{RelativeSource AncestorType=UserControl}" Path="DataContext.CurrentSortDirection" />
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Fill" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="目录" Width="360">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DirectoryPath}" Foreground="White"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryPath}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="大小" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeDisplay}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="文件数" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileCountDisplay}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="状态" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDisplay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="操作" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="搬回" Command="{Binding DataContext.MoveBackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource GhostButton}"
                                            Padding="12,6" FontSize="12"
                                            Visibility="{Binding IsMoved, Converter={StaticResource BoolToVis}}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- 搬移任务进度 -->
            <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Visibility="{Binding IsMoving, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <StackPanel>
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,8" />
                    <ItemsControl ItemsSource="{Binding Tasks}" MaxHeight="120">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="12" />
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
