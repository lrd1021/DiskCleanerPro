<UserControl x:Class="DiskCleaner.Views.SoftwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:DiskCleaner.Helpers"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <helpers:SortIndicatorConverter x:Key="SortIndicator" />
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="32,28,32,16">
            <StackPanel>
                <TextBlock Text="软件管理" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
                <TextBlock Text="查看已安装软件列表，启动卸载程序，打开安装目录" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />

                <DockPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="加载软件列表" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <TextBlock Text="搜索：" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Width="280" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,12,0,0">
                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="13" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- 软件列表 -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Margin="32,0,32,28" Padding="0" ClipToBounds="True">
            <ListView x:Name="SoftwareList" ItemsSource="{Binding FilteredSoftware}" SelectedItem="{Binding SelectedSoftware}"
                      Background="Transparent" BorderThickness="0"
                      Foreground="White" GridViewColumnHeader.Click="ListViewColumnHeader_Click">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridViewColumnHeader">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="0,0,17,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            <StackPanel Grid.Column="1" Orientation="Vertical"
                                                        Margin="6,0,2,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                                <Path x:Name="UpArrow" Data="M0,4 L4,0 L8,4 Z" Width="8" Height="4"
                                                      Fill="{StaticResource TextMutedBrush}" Margin="0,0,0,1" />
                                                <Path x:Name="DownArrow" Data="M0,0 L4,4 L8,0 Z" Width="8" Height="4"
                                                      Fill="{StaticResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource SortIndicator}" ConverterParameter="Up">
                                                    <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header" />
                                                    <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.CurrentSortColumnHeader" />
                                                    <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.CurrentSortDirection" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="UpArrow" Property="Fill" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource SortIndicator}" ConverterParameter="Down">
                                                    <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header" />
                                                    <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.CurrentSortColumnHeader" />
                                                    <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.CurrentSortDirection" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="DownArrow" Property="Fill" Value="White" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}" Padding="8,6">
                                        <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="软件名称" Width="280">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="发布者" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Publisher}" Foreground="White" FontSize="13" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="版本" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Version}" Foreground="White" FontSize="13" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="大小" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeDisplay}" Foreground="{StaticResource AccentBrush}" FontSize="13" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="操作" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="卸载" Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="12,6" FontSize="12" Margin="0,0,8,0" />
                                        <Button Content="打开目录" Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</UserControl>
