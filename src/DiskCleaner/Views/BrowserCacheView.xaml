<UserControl x:Class="DiskCleaner.Views.BrowserCacheView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel>
            <TextBlock Text="浏览器缓存清理" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
            <TextBlock Text="清理 Chrome / Edge / Firefox 缓存文件，不触碰密码、书签和扩展" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24" />

            <DockPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="🔍 扫描" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                    <Button Content="🧹 清理选中" Command="{Binding CleanCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,0" />
                </StackPanel>
                <CheckBox Content="永久删除" IsChecked="{Binding PermanentDelete}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>

            <StackPanel Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,0,0,16">
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>

            <Border Style="{StaticResource CardPanel}" Margin="0,0,0,20">
                <DockPanel>
                    <TextBlock Text="缓存总量" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCacheDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0" />
                </DockPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Browsers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                            <DockPanel>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Icon}" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding SizeDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="#2D2D3F" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="💡 提示" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="1. 清理前请关闭对应的浏览器，否则部分缓存文件被占用无法删除。&#x0a;2. 清理缓存不影响您的密码、书签和历史记录。&#x0a;3. 缓存会在后续使用中自动重新生成，首次访问网页可能略慢。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
