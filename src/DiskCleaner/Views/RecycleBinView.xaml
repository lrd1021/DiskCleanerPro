<UserControl x:Class="DiskCleaner.Views.RecycleBinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="回收站清空" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
            <TextBlock Text="查看并清空C盘（或所有盘）回收站中的文件" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24" />

            <!-- 回收站状态卡片 -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="32,28" Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🗑️" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="C盘回收站" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding SizeDisplay}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding ItemDisplay}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="🔄 刷新" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
                        <Button Content="🗑️ 清空C盘" Command="{Binding EmptyCommand}" Style="{StaticResource DangerButton}" Margin="0,0,12,0" />
                        <Button Content="🗑️ 清空所有盘" Command="{Binding EmptyAllCommand}" Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,0,0,16">
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

            <Border Background="#2D2D3F" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="⚠️ 注意事项" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="1. 清空回收站是不可逆操作，文件将永久删除。&#x0a;2. 被程序占用的文件可能无法删除，建议关闭相关程序后重试。&#x0a;3. 清空所有盘会清理所有磁盘分区的回收站。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
