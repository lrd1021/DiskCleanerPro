<UserControl x:Class="DiskCleaner.Views.RecycleBinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:DiskCleaner.Helpers"
             Background="{StaticResource BackgroundBrush}">
    <UserControl.Resources>
        <helpers:GroupSummaryConverter x:Key="GroupSummary" />
        <helpers:SortIndicatorConverter x:Key="SortIndicator" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="回收站清空" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4" />
            <TextBlock Text="查看并清空C盘（或所有盘）回收站中的文件" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,24" />

            <!-- 回收站状态卡片 -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="32,28" Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="C盘回收站" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding SizeDisplay}" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding ItemDisplay}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
                        <Button Content="清空C盘" Command="{Binding EmptyCommand}" Style="{StaticResource DangerButton}" Margin="0,0,12,0" />
                        <Button Content="清空所有盘" Command="{Binding EmptyAllCommand}" Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 回收站文件列表（含分类与恢复） -->
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20,16" Margin="0,0,0,24">
                <StackPanel>
                    <!-- 分类维度选择 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="分类方式：" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding CategoryOptions}"
                                  SelectedValuePath="Mode"
                                  SelectedValue="{Binding CategoryMode, Mode=TwoWay}"
                                  Width="120"
                                  Style="{StaticResource ModernComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Foreground="White" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding CategoryModeSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox Content="全选" IsChecked="{Binding SelectAll, Mode=TwoWay}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding ListCount, StringFormat='共 {0} 个文件'}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="恢复选中" Command="{Binding RestoreCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" />
                        <Button Content="恢复全部" Command="{Binding RestoreAllCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>

                    <ListView x:Name="RecycleBinList" ItemsSource="{Binding ItemsView}" Foreground="White" MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" GridViewColumnHeader.Click="ListViewColumnHeader_Click"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewColumnHeader">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="0,0,17,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                    <StackPanel Grid.Column="1" Orientation="Vertical"
                                                                Margin="6,0,2,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                                        <Path x:Name="UpArrow" Data="M0,4 L4,0 L8,4 Z" Width="8" Height="4"
                                                              Fill="{StaticResource TextMutedBrush}" Margin="0,0,0,1" />
                                                        <Path x:Name="DownArrow" Data="M0,0 L4,4 L8,0 Z" Width="8" Height="4"
                                                              Fill="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource SortIndicator}" ConverterParameter="Up">
                                                            <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header" />
                                                            <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.CurrentSortColumnHeader" />
                                                            <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.CurrentSortDirection" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter TargetName="UpArrow" Property="Fill" Value="White" />
                                                </DataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource SortIndicator}" ConverterParameter="Down">
                                                            <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header" />
                                                            <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.CurrentSortColumnHeader" />
                                                            <Binding RelativeSource="{RelativeSource AncestorType=ListView}" Path="DataContext.CurrentSortDirection" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter TargetName="DownArrow" Property="Fill" Value="White" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Padding" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Resources>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="13" />
                                            <TextBlock Text="{Binding ItemCount, StringFormat='  ·  {0} 项'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ., Converter={StaticResource GroupSummary}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="恢复" Width="48">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="清理来源" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SourceCategory}" Foreground="White" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="原路径" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding OriginalPath}" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="大小" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeDisplay}" Foreground="White" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="删除时间" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DeletedAtDisplay}" Foreground="White" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock Text="列表包含本机所有固定盘上当前用户的回收站文件（不只 C 盘）。恢复会把文件移回原路径，并从回收站移除。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" Margin="0,0,0,16">
                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding ResultMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

            <Border Background="#2D2D2D" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="注意事项" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="1. 清空回收站是不可逆操作，文件将永久删除。&#x0a;2. 被程序占用的文件可能无法删除，建议关闭相关程序后重试。&#x0a;3. 清空所有盘会清理所有磁盘分区的回收站。&#x0a;4. 分类按文件自身属性（类型/位置/时间/大小）自动识别，仅用于在列表中分组查看。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
