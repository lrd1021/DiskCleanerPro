<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DiskCleaner</RootNamespace>
    <AssemblyName>DiskCleanerPro</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <!-- 安全：显式关闭 BinaryFormatter（代码未使用；默认 false，但 SDK 可能因传递依赖自动置 true，
         显式置 false 可消除运行时序列化后门告警，见 review_DiskCleanerPro.md §4-6 -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

  <!-- Release 发布包剥离 pdb，降低被逆向风险 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskCleaner.Elevated\DiskCleaner.Elevated.csproj" />
  </ItemGroup>

</Project>
